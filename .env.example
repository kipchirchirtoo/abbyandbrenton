# ---------- Site ----------
# Public URL of the deployed site (used to build invitation links in emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://abigaelandbrenton.vercel.app

# true  = homepage shows a "private" screen; wedding content only via /invite/<token>
# false = homepage stays public (current behaviour, RSVP goes to the Google Sheet)
PRIVATE_MODE=false

# ---------- Supabase (server only: NEVER prefix these with NEXT_PUBLIC_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ---------- Resend (email) ----------
RESEND_API_KEY=re_...
# Must be an address on a domain you verified in Resend, e.g. "Abigael & Brenton <invites@yourdomain.com>"
RESEND_FROM=

# ---------- Admin dashboard (/admin) ----------
ADMIN_PASSWORD=choose-a-long-passphrase
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ---------- Legacy public-mode RSVP fallbacks (no longer used by the RSVP form; kept for the old static site) ----------
# NEXT_PUBLIC_SHEET_URL=
# NEXT_PUBLIC_WHATSAPP_NUMBER=2547XXXXXXXX
# NEXT_PUBLIC_RSVP_EMAIL=

# ---------- M-Pesa gifts (Safaricom Daraja STK push). Optional: without these the gift page shows the manual number only ----------
# NOTE: STK push pays into a Paybill or Till (shortcode), not a personal phone number.
MPESA_ENV=sandbox                # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline (Till)
# MPESA_PARTY_B=                 # Till number when using CustomerBuyGoodsOnline
# Random string, 24+ chars. Becomes part of the callback URL, e.g. /api/mpesa/callback/<secret>
MPESA_CALLBACK_SECRET=

# ---------- Room bookings: Paystack ----------
# Secret key from Paystack dashboard > Settings > API Keys & Webhooks (sk_test_... for testing, sk_live_... for real money).
# Set the webhook URL there to https://YOUR-SITE/api/paystack/webhook
# Where the money goes: Paystack dashboard > Settings > Bank accounts (your settlement account).
PAYSTACK_SECRET_KEY=
# Show the SAMPLE (unpublished) rooms so you can preview the booking page. Leave unset in production.
# BOOKING_PREVIEW=true
